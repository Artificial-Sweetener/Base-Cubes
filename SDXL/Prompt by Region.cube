      "SimpleSyrup.KSamplerAttentionCoupling": {
        "input": {
          "required": {
            "model": [
              "MODEL",
              {
                "tooltip": "Supported Anima or standard SD/SDXL model used for one shared denoiser trajectory; apply global model LoRAs before connecting it."
              }
            ],
            "seed": [
              "INT",
              {
                "tooltip": "Seed used to create sampling noise. Reusing it with matching settings makes results repeatable.",
                "default": 0,
                "min": 0,
                "max": 18446744073709551615,
                "control_after_generate": true
              }
            ],
            "steps": [
              "INT",
              {
                "tooltip": "Number of denoising steps. More steps can add refinement but take longer.",
                "default": 20,
                "min": 1,
                "max": 10000
              }
            ],
            "cfg": [
              "FLOAT",
              {
                "tooltip": "Prompt guidance strength. Higher values follow the positive prompt more strongly but can look overcooked.",
                "default": 8.0,
                "min": 0.0,
                "max": 100.0,
                "step": 0.1,
                "round": 0.01
              }
            ],
            "sampler_name": [
              "COMBO",
              {
                "tooltip": "Sampling algorithm. It affects the image's look, speed, and stability.",
                "multiselect": false,
                "options": [
                  "euler",
                  "euler_cfg_pp",
                  "euler_ancestral",
                  "euler_ancestral_cfg_pp",
                  "heun",
                  "heunpp2",
                  "exp_heun_2_x0",
                  "exp_heun_2_x0_sde",
                  "dpm_2",
                  "dpm_2_ancestral",
                  "lms",
                  "dpm_fast",
                  "dpm_adaptive",
                  "dpmpp_2s_ancestral",
                  "dpmpp_2s_ancestral_cfg_pp",
                  "dpmpp_sde",
                  "dpmpp_sde_gpu",
                  "dpmpp_2m",
                  "dpmpp_2m_cfg_pp",
                  "dpmpp_2m_sde",
                  "dpmpp_2m_sde_gpu",
                  "dpmpp_2m_sde_heun",
                  "dpmpp_2m_sde_heun_gpu",
                  "dpmpp_3m_sde",
                  "dpmpp_3m_sde_gpu",
                  "ddpm",
                  "lcm",
                  "ipndm",
                  "ipndm_v",
                  "deis",
                  "res_multistep",
                  "res_multistep_cfg_pp",
                  "res_multistep_ancestral",
                  "res_multistep_ancestral_cfg_pp",
                  "gradient_estimation",
                  "gradient_estimation_cfg_pp",
                  "er_sde",
                  "seeds_2",
                  "seeds_3",
                  "sa_solver",
                  "sa_solver_pece",
                  "ddim",
                  "uni_pc",
                  "uni_pc_bh2",
                  "euler_a_a1111"
                ]
              }
            ],
            "scheduler": [
              "COMBO",
              {
                "tooltip": "Noise schedule used during sampling. It changes how quickly structure and detail form.",
                "multiselect": false,
                "options": [
                  "simple",
                  "sgm_uniform",
                  "karras",
                  "exponential",
                  "ddim_uniform",
                  "beta",
                  "normal",
                  "linear_quadratic",
                  "kl_optimal",
                  "ays",
                  "ays+",
                  "ays_30",
                  "ays_30+",
                  "gits",
                  "beta_1_1",
                  "AYS SD1",
                  "AYS SDXL",
                  "GITS",
                  "beta57",
                  "automatic_a1111",
                  "Flux2"
                ]
              }
            ],
            "positive": [
              "CONDITIONING,CONDITIONING_BATCH",
              {
                "tooltip": "Global-first positive conditioning: entry 0 is global and later entries pair with masks. Regional Prompt Control WeightHooks may contain ordered full-rank Anima LoRA stacks with independent schedules; standard SD/SDXL rejects regional model-side hooks."
              }
            ],
            "negative": [
              "CONDITIONING,CONDITIONING_BATCH",
              {
                "tooltip": "Global-first negative conditioning aligned to the same masks; Anima regional LoRA hooks retain their negative-branch ownership and independent schedules."
              }
            ],
            "regional_prompt_weight": [
              "FLOAT",
              {
                "tooltip": "Balances regional cross-attention against the global prompt from 0 (global only) to 1 (regional only inside solid masks); regional Anima LoRA strength remains controlled by each hook.",
                "default": 1.0,
                "min": 0.0,
                "max": 1.0,
                "step": 0.01,
                "round": 0.01
              }
            ],
            "region_mask_feather": [
              "INT",
              {
                "tooltip": "Softens Attention Coupling and Anima regional LoRA boundaries by this many image pixels; 0 preserves authored mask values.",
                "default": 0,
                "min": 0,
                "max": 512,
                "step": 1
              }
            ],
            "latent_image": [
              "LATENT",
              {
                "tooltip": "Latent input whose samples will be denoised."
              }
            ],
            "denoise": [
              "FLOAT",
              {
                "tooltip": "Sampling strength. Lower values preserve the input more; higher values allow larger changes.",
                "default": 1.0,
                "min": 0.0,
                "max": 1.0,
                "step": 0.01
              }
            ]
          },
          "optional": {
            "region_masks": [
              "MASK",
              {
                "tooltip": "Optional ordered masks paired with conditioning entries 1 onward. Leave disconnected with ordinary conditioning to bypass Attention Coupling. In overlaps, prompt contributions are normalized while Anima regional LoRA deltas add in declared adapter and region order."
              }
            ]
          }
        },
        "input_order": {
          "required": [
            "model",
            "seed",
            "steps",
            "cfg",
            "sampler_name",
            "scheduler",
            "positive",
            "negative",
            "regional_prompt_weight",
            "region_mask_feather",
            "latent_image",
            "denoise"
          ],
          "optional": [
            "region_masks"
          ]
        },
        "is_input_list": false,
        "output": [
          "LATENT"
        ],
        "output_is_list": [
          false
        ],
        "output_name": [
          "latent"
        ],
        "output_tooltips": [
          "Denoised latent for VAE decode or more latent processing."
        ],
        "output_matchtypes": null,
        "name": "SimpleSyrup.KSamplerAttentionCoupling",
        "display_name": "KSampler (Attention Coupling)",
        "description": "With ordinary conditioning and no masks, denoises through the normal KSampler path without Attention Coupling preparation. With conditioning batches and masks, denoises supported Anima and standard SD/SDXL models through one shared trajectory while coupling global and masked regional cross-attention. The input MODEL may carry a global LoRA. Anima regions may also carry ordered, independently scheduled Prompt Control model LoRAs whose overlapping deltas compose in declared order. Runtime scales with active adapters, ranks, and targets. Standard SD/SDXL regional model-side hooks and unsupported Anima adapter targets fail before sampling.",
        "python_module": "custom_nodes.SimpleSyrup",
        "category": "SimpleSyrup/Sampling",
        "output_node": false,
        "deprecated": false,
        "experimental": false,
        "dev_only": false,
        "api_node": false,
        "price_badge": null,
        "search_aliases": [
          "attention coupling",
          "regional lora",
          "anima regional prompt",
          "sdxl regional prompt"
        ],
        "essentials_category": null,
        "has_intermediate_output": false
      },
