      "SimpleSyrup.ScheduleAndEncodePromptsWithPromptControl": {
        "input": {
          "required": {
            "model": [
              "MODEL",
              {
                "tooltip": "Model that receives LoRA changes found in Prompt-Control prompt tags.",
                "rawLink": true
              }
            ],
            "clip": [
              "CLIP",
              {
                "tooltip": "CLIP connection used for scheduled hooks and cleaned prompt encoding.",
                "rawLink": true
              }
            ],
            "positive_prompt": [
              "STRING",
              {
                "tooltip": "Positive Prompt-Control text; [SEP] or [SEP|name] creates ordered conditioning entries, and global text fills missing positive regions.",
                "default": "",
                "multiline": false
              }
            ],
            "negative_prompt": [
              "STRING",
              {
                "tooltip": "Negative Prompt-Control text; [SEP] or [SEP|name] creates ordered conditioning entries, and global text fills missing negative regions.",
                "default": "",
                "multiline": false
              }
            ]
          },
          "optional": {
            "encode_style": [
              "STRING",
              {
                "tooltip": "Encode style text from Prompt Encode Style or Prompt Encode Style & Normalization.",
                "default": "",
                "forceInput": true,
                "multiline": false
              }
            ]
          }
        },
        "input_order": {
          "required": [
            "model",
            "clip",
            "positive_prompt",
            "negative_prompt"
          ],
          "optional": [
            "encode_style"
          ]
        },
        "is_input_list": false,
        "output": [
          "MODEL",
          "CONDITIONING,CONDITIONING_BATCH",
          "CONDITIONING,CONDITIONING_BATCH"
        ],
        "output_is_list": [
          false,
          false,
          false
        ],
        "output_name": [
          "model",
          "positive",
          "negative"
