      "SimpleSyrup.ResizeImageToTarget": {
        "input": {
          "required": {
            "image": [
              "IMAGE",
              {
                "tooltip": "Image batch to resize to the target dimensions."
              }
            ],
            "width": [
              "INT",
              {
                "tooltip": "Target width in pixels before divisibility rounding.",
                "default": 1024,
                "min": 1,
                "max": 16384,
                "step": 1
              }
            ],
            "height": [
              "INT",
              {
                "tooltip": "Target height in pixels before divisibility rounding.",
                "default": 1024,
                "min": 1,
                "max": 16384,
                "step": 1
              }
            ],
            "resize_mode": [
              "COMBO",
              {
                "tooltip": "How aspect ratio is handled. Stretch fills exactly, crop trims overflow, and pad fills empty space.",
                "default": "Keep AR",
                "multiselect": false,
                "options": [
                  "Stretch",
                  "Keep AR",
                  "Crop (Cover + Crop)",
                  "Pad (Fit + Pad)"
                ]
              }
            ],
            "sampling": [
              "COMBO",
              {
                "tooltip": "Resize filter. Sharper filters preserve detail but can show more ringing.",
                "default": "lanczos",
                "multiselect": false,
                "options": [
                  "nearest-exact",
                  "bilinear",
                  "area",
                  "bicubic",
                  "lanczos"
                ]
              }
            ],
            "processor": [
              "COMBO",
              {
                "tooltip": "Processor used for resizing. GPU is usually faster; CPU can reduce GPU memory pressure.",
                "default": "gpu",
                "multiselect": false,
                "options": [
                  "cpu",
                  "gpu"
                ]
              }
            ],
            "divisible_by": [
              "INT",
              {
                "tooltip": "Round final dimensions to a multiple of this value for model or latent-size compatibility.",
                "default": 1,
                "min": 1,
                "max": 4096,
                "step": 1
              }
            ],
            "crop_position": [
              "COMBO",
              {
                "tooltip": "Anchor used when crop mode trims overflow from the resized image.",
                "default": "center",
                "multiselect": false,
                "options": [
                  "center",
                  "top-left",
                  "top",
                  "top-right",
                  "left",
                  "right",
                  "bottom-left",
                  "bottom",
                  "bottom-right"
                ]
              }
            ],
            "pad_color": [
              "STRING",
              {
                "tooltip": "RGB color used to fill empty space in pad mode.",
                "default": "0, 0, 0",
                "multiline": false
              }
            ],
            "max_batch_size": [
              "INT",
              {
                "tooltip": "Maximum images resized at once. Lower values reduce memory use; 0 processes the full batch together.",
                "default": 0,
                "min": 0,
                "max": 4096,
                "step": 1
              }
            ],
            "sinc_window": [
              "INT",
              {
                "tooltip": "Lanczos window size. Higher values can look sharper but may add ringing.",
                "default": 3,
                "min": 1,
                "max": 8,
                "step": 1
              }
            ],
            "precision": [
              "COMBO",
              {
                "tooltip": "Math precision for resizing. Lower precision can save memory but may slightly change results.",
                "default": "fp32",
                "multiselect": false,
                "options": [
                  "fp32",
                  "fp16",
                  "bf16"
                ]
              }
            ]
          },
          "optional": {
            "mask": [
              "MASK",
              {
                "tooltip": "Optional mask to resize with the image batch."
              }
            ]
          }
        },
        "input_order": {
          "required": [
            "image",
            "width",
            "height",
            "resize_mode",
            "sampling",
            "processor",
            "divisible_by",
            "crop_position",
            "pad_color",
            "max_batch_size",
            "sinc_window",
            "precision"
          ],
          "optional": [
            "mask"
          ]
        },
        "is_input_list": false,
        "output": [
          "IMAGE",
          "INT",
          "INT",
          "MASK"
        ],
        "output_is_list": [
          false,
          false,
          false,
          false
        ],
        "output_name": [
          "image",
          "width",
          "height",
          "mask"
        ],
        "output_tooltips": [
          "Resized image batch after aspect-ratio handling and divisibility rounding.",
          "Final image width in pixels.",
          "Final image height in pixels.",
          "Resized mask aligned to the output image size."
        ],
        "output_matchtypes": null,
