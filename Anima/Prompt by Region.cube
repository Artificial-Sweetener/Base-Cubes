              {
                "tooltip": "Model whose sampler-provided initial noise will receive seed variation."
              }
            ],
            "variation_seed": [
              "INT",
              {
                "tooltip": "Seed for the second noise pattern. Change it to explore another variation direction from the sampler's seed.",
                "default": 0,
                "min": 0,
                "max": 18446744073709551615,
                "control_after_generate": true
              }
            ],
            "variation_strength": [
              "FLOAT",
              {
                "tooltip": "Noise interpolation strength. 0 keeps the sampler seed unchanged; 1 uses the variation seed for initial noise.",
                "default": 0.0,
                "min": 0.0,
                "max": 1.0,
                "step": 0.01,
                "round": 0.01
              }
            ]
          }
        },
