    "definitions": {
      "SimpleSyrup.SimpleLoadKrea2": {
        "input": {
          "required": {
            "diffusion_model": [
              [
                "LIST"
              ],
              {
                "tooltip": "Krea 2 Raw or Turbo diffusion model to load. This node validates the architecture and never downloads this file.",
                "multiselect": false
              }
            ],
            "diffusion_weight_dtype": [
              [
                "LIST"
              ],
              {
                "tooltip": "Load-time diffusion precision; default preserves the selected file's stored BF16, FP8, INT8, MXFP8, or NVFP4 format.",
                "advanced": true,
                "default": "default",
                "multiselect": false
              }
            ],
            "text_encoder": [
              [
                "LIST"
              ],
              {
                "tooltip": "Qwen3-VL 4B encoder loaded with Krea 2's required 12-layer conditioning. Auto uses FP8; selecting official FP8 or BF16 downloads that checksum-pinned file when missing.",
                "advanced": true,
                "default": "auto",
                "multiselect": false
              }
            ],
            "text_encoder_device": [
              [
                "LIST"
              ],
              {
                "tooltip": "Device for Qwen3-VL; CPU saves GPU memory but makes prompt encoding slower.",
                "advanced": true,
                "default": "default",
                "multiselect": false
              }
            ],
            "vae": [
              [
                "LIST"
              ],
              {
                "tooltip": "VAE used to decode Krea 2 latents. Auto finds or downloads the checksum-pinned Qwen Image VAE with visible progress.",
                "advanced": true,
                "default": "auto",
                "multiselect": false
              }
            ]
          }
        },
        "input_order": {
          "required": [
            "diffusion_model",
            "diffusion_weight_dtype",
            "text_encoder",
            "text_encoder_device",
            "vae"
          ]
        },
        "is_input_list": false,
        "output": [
          "MODEL",
          "CLIP",
          "VAE"
        ],
        "output_is_list": [
          false,
          false,
          false
        ],
        "output_name": [
          "model",
          "clip",
          "vae"
        ],
        "output_tooltips": [
          "Loaded diffusion model for downstream MODEL inputs.",
          "Loaded text encoder for downstream CLIP inputs.",
          "Loaded VAE used to encode images to latents and decode latents to images."
        ],
        "output_matchtypes": null,
        "name": "SimpleSyrup.SimpleLoadKrea2",
        "display_name": "Simple Load Krea 2",
        "description": "Loads Krea 2 with its Qwen3-VL 4B encoder and Qwen Image VAE; automatic components are downloaded from checksum-pinned Hugging Face files.",
        "python_module": "custom_nodes.SimpleSyrup",
        "category": "SimpleSyrup/Loaders",
        "output_node": false,
        "deprecated": false,
        "experimental": false,
        "dev_only": false,
