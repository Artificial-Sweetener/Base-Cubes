      "SimpleSyrup.KSampler": {
        "input": {
          "required": {
            "model": [
              "MODEL",
              {
                "tooltip": "Diffusion model used to denoise the input latent."
              }
            ],
            "seed": [
              "INT",
              {
                "tooltip": "Seed used to create sampling noise. Reusing it with matching settings makes results repeatable.",
                "default": 0,
                "min": 0,
                "max": 18446744073709551615,
                "control_after_generate": true
              }
            ],
            "steps": [
              "INT",
              {
                "tooltip": "Number of denoising steps. More steps can add refinement but take longer.",
                "default": 20,
                "min": 1,
                "max": 10000
              }
            ],
            "cfg": [
              "FLOAT",
              {
                "tooltip": "Prompt guidance strength. Higher values follow the positive prompt more strongly but can look overcooked.",
                "default": 8.0,
                "min": 0.0,
                "max": 100.0,
                "step": 0.1,
                "round": 0.01
              }
            ],
            "sampler_name": [
              [
                "LIST"
              ],
              {
                "tooltip": "Sampling algorithm. It affects the image's look, speed, and stability.",
                "multiselect": false
              }
            ],
            "scheduler": [
              [
                "LIST"
              ],
              {
                "tooltip": "Noise schedule used during sampling. It changes how quickly structure and detail form.",
                "multiselect": false
              }
            ],
            "positive": [
              "CONDITIONING,CONDITIONING_BATCH",
              {
                "tooltip": "Positive conditioning that guides what the sampler should add."
              }
            ],
            "latent_image": [
              "LATENT",
              {
                "tooltip": "Latent input whose samples will be denoised."
              }
            ],
            "denoise": [
              "FLOAT",
              {
                "tooltip": "Sampling strength. Lower values preserve the input more; higher values allow larger changes.",
                "default": 1.0,
                "min": 0.0,
                "max": 1.0,
                "step": 0.01
              }
            ]
          },
          "optional": {
            "negative": [
              "CONDITIONING,CONDITIONING_BATCH",
              {
                "tooltip": "Optional conditioning that guides what the sampler should avoid. Leave disconnected for positive-only sampling without CFG."
              }
            ],
            "options": [
              "SIMPLE_SYRUP_SAMPLER_OPTIONS",
              {
                "tooltip": "Optional preceding sampler options; bypass this node to omit its contribution."
              }
            ],
            "segs": [
              "SEGS",
              {
                "tooltip": "Guides local sampling regions when Tiling or Contextual Diffusion options are connected; ignored otherwise."
              }
            ],
            "region_masks": [
              "MASK",
              {
                "tooltip": "Ordered masks paired with global-first conditioning batches when Attention Coupling options are connected; ignored otherwise."
              }
            ]
          }
        },
