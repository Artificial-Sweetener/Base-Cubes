      "SimpleSyrup.ContextualDiffusionOptions": {
        "input": {
          "required": {
            "latent_context_size": [
              "INT",
              {
                "tooltip": "Maximum side of each model context in latent pixels. Larger contexts preserve more relationships but use more memory.",
                "default": 96,
                "min": 16,
                "max": 512,
                "step": 16
              }
            ],
            "global_weight": [
              "FLOAT",
              {
                "tooltip": "Strength of whole-image low-frequency guidance. 1 makes the global context authoritative; lower values allow more tile interpretation.",
                "default": 1.0,
                "min": 0.0,
                "max": 2.0,
                "step": 0.05
              }
            ],
            "global_steps": [
              "INT",
              {
                "tooltip": "Number of initial denoising steps that use the global context. Fewer steps leave more late sampling for local detail.",
                "default": 1,
                "min": 0,
                "max": 10000,
                "step": 1
              }
            ],
            "global_decay": [
              "FLOAT",
              {
                "tooltip": "Multiplier applied to whole-image strength after each global step. Lower values hand control to local contexts faster.",
                "default": 0.5,
                "min": 0.0,
                "max": 1.0,
                "step": 0.05
              }
            ],
            "diffusion_mode": [
              [
                "LIST"
              ],
              {
                "tooltip": "Tile overlap blend. MultiDiffusion averages predictions; Mixture of Diffusers gives tile centers more influence.",
                "default": "multidiffusion",
                "multiselect": false
              }
            ],
            "latent_context_overlap": [
              "INT",
              {
                "tooltip": "Overlap between local latent contexts in latent pixels. Larger overlaps reduce seams but increase sampling work.",
                "default": 32,
                "min": 0,
                "max": 256,
                "step": 4
              }
            ],
            "latent_context_batch_size": [
              "INT",
              {
                "tooltip": "Number of equal-sized latent contexts sampled together. Higher values can be faster but use more memory.",
                "default": 4,
                "min": 1,
                "max": 8,
                "step": 1
              }
            ],
            "differential_diffusion": [
              "BOOLEAN",
              {
                "tooltip": "Uses the noise mask to vary denoising strength spatially; preserves existing model mask behavior.",
                "default": false
              }
            ]
          },
          "optional": {
            "options": [
              "SIMPLE_SYRUP_SAMPLER_OPTIONS",
              {
                "tooltip": "Optional preceding sampler options; bypass this node to omit its contribution."
              }
            ]
          }
        },
        "input_order": {
          "required": [
            "latent_context_size",
            "global_weight",
            "global_steps",
            "global_decay",
            "diffusion_mode",
            "latent_context_overlap",
            "latent_context_batch_size",
            "differential_diffusion"
          ],
          "optional": [
            "options"
          ]
        },
        "is_input_list": false,
        "output": [
          "SIMPLE_SYRUP_SAMPLER_OPTIONS"
        ],
        "output_is_list": [
          false
        ],
        "output_name": [
          "options"
        ],
        "output_tooltips": [
          "Combined sampler options; connect another options node or KSampler."
        ],
        "output_matchtypes": null,
        "name": "SimpleSyrup.ContextualDiffusionOptions",
