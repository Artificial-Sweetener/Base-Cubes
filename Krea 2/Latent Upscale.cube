      "SimpleSyrup.VAEDecodeOptions": {
        "input": {
          "required": {
            "use_tiling": [
              "BOOLEAN",
              {
                "tooltip": "Use ComfyUI's tiled VAE node. Disabled uses normal ComfyUI VAE behavior, including its automatic tiled retry after out-of-memory.",
                "default": false
              }
            ],
            "samples": [
              "LATENT",
              {
                "tooltip": "Latent samples to decode into an image.",
                "rawLink": true
              }
            ],
            "vae": [
              "VAE",
              {
                "tooltip": "VAE used for the selected encode or decode operation.",
                "rawLink": true
              }
            ],
            "tile_size": [
              "INT",
              {
                "tooltip": "Tile size in pixels. Larger tiles are faster but use more memory.",
                "advanced": true,
                "default": 512,
                "min": 64,
                "max": 4096,
                "step": 32
              }
            ],
            "overlap": [
              "INT",
              {
                "tooltip": "Overlap between tiles in pixels. Larger overlaps reduce seams but do more work.",
                "advanced": true,
                "default": 64,
                "min": 0,
                "max": 4096,
                "step": 32
              }
            ],
            "temporal_size": [
              "INT",
              {
                "tooltip": "For video VAEs, number of frames to decode at once.",
                "advanced": true,
                "default": 64,
